# Public repository: only the reproducible example belongs here.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.env.example
!/.node-version
!/.python-version
!/.npmrc
!/.prettierignore
!/README.md
!/LICENSE
!/compose.yaml
!/Dockerfile.node
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/pyproject.toml
!/uv.lock
!/eslint.config.js
!/apps/
!/scripts/
!/docs/

# Only documentation for readers, never internal state or evidence.
/docs/*
!/docs/configuracion-aps.md
!/docs/versiones.md
!/docs/importar-excel.md
!/docs/herramientas-mcp.md

# Application sources, configuration and tests.
/apps/*
!/apps/api/
!/apps/web/
!/apps/mcp/
/apps/api/*
!/apps/api/app/
!/apps/api/migrations/
!/apps/api/tests/
!/apps/api/Dockerfile
!/apps/api/alembic.ini
!/apps/api/pyproject.toml
/apps/web/*
!/apps/web/src/
!/apps/web/index.html
!/apps/web/package.json
!/apps/web/tsconfig.json
!/apps/web/vite.config.ts
/apps/mcp/*
!/apps/mcp/src/
!/apps/mcp/.env.example
!/apps/mcp/package.json
!/apps/mcp/tsconfig.json
!/apps/mcp/tsconfig.build.json
/scripts/*
!/scripts/check.ps1
!/scripts/init_local_env.py
!/scripts/smoke.mjs

# Defense in depth under allowed source directories.
**/.env
**/.env.*
!**/.env.example
**/node_modules/
**/.venv/
**/.cache/
**/data/
**/dist/
**/build/
**/coverage/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.py[cod]
*.tsbuildinfo
*.db
*.db-*
*.sqlite*
*.log
*.pem
*.key
*.pfx
*.p12
*.bak
*.tmp
.DS_Store
Thumbs.db
