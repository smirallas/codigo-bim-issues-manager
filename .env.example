# Configuración local. Copiar a .env; no introducir valores reales en este ejemplo.
ISSUES_DATABASE_URL=sqlite+pysqlite:///./data/issues.db
API_BASE_URL=http://127.0.0.1:8000
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# E01: sin credenciales, clave válida y lista de acceso, el login permanece cerrado.
WEB_ORIGIN=http://127.0.0.1:5173
ACCESS_ALLOWED_EMAILS=
ACCESS_ALLOWED_DOMAINS=
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_CALLBACK_URL=http://127.0.0.1:8000/auth/autodesk/callback
# Clave Fernet generada localmente; no reutilizar la de DataForge ni enviarla por chat.
ISSUES_TOKEN_ENCRYPTION_KEY=
ISSUES_SESSION_TTL_SECONDS=28800
ISSUES_COOKIE_SECURE=false
# MCP E06: disabled o fixtures. Nunca copiar tokens APS al MCP.
MCP_DATA_MODE=disabled
