# Solo configuración MCP. No copiar APS_CLIENT_SECRET ni la clave de cifrado de la API.
API_BASE_URL=http://127.0.0.1:8000
# disabled: catálogo visible, operaciones bloqueadas. fixtures: solo ensayo sintético.
MCP_DATA_MODE=disabled
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_ALLOWED_HOSTS=127.0.0.1,localhost
MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8001,http://localhost:8001

# autodesk: OAuth propio y contexto verificado en FastAPI.
ISSUES_MCP_ISSUER=http://127.0.0.1:8001
ISSUES_MCP_INTERNAL_SECRET=
MCP_STORAGE_KEY=
MCP_STORAGE_FILE=./data/oauth.db
WEB_ORIGIN=http://127.0.0.1:5173
MCP_CLIENT_ID=
MCP_CLIENT_REDIRECT_URI=
